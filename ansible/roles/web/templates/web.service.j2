# {{ ansible_managed }}
[Unit]
Description=Cache-aside report web application
After=network-online.target
Wants=network-online.target

[Service]
User=www-data
WorkingDirectory={{ web_dir }}
ExecStart={{ web_dir }}/venv/bin/python {{ web_dir }}/app.py
Restart=on-failure
RestartSec=2

Environment=PG_HOST={{ pg_host }}
Environment=PG_DATABASE={{ pg_database }}
Environment=PG_USER={{ pg_user }}
Environment=PG_PASSWORD={{ pg_password }}
Environment=REDIS_HOST={{ redis_host }}
Environment=CACHE_TTL={{ cache_ttl_seconds }}
Environment=QUERY_FILE={{ web_dir }}/query.sql
Environment=PORT={{ web_port }}

[Install]
WantedBy=multi-user.target
